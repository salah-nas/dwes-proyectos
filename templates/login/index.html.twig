{% extends 'base.html.twig' %}

{% block title %}Iniciar sesión{% endblock %}

{% block body %}
    <div class="panel">
        <h1>Iniciar sesión</h1>
        <form method="post">
            {% if error %}
                <div class="alert error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus>

            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn" type="submit">Entrar</button>
        </form>
        <p class="gris">¿No tienes cuenta? <a href="{{ path('app_registro') }}">Regístrate</a></p>
    </div>
{% endblock %}
