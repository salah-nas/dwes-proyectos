{% extends 'base.html.twig' %}

{% block title %}Elegir carta · Cartas Pokémon{% endblock %}

{% block body %}
<section class="pantalla-juego">
    <p class="juego-eyebrow">Pokémon Trading Cards</p>
    {% if ronda is null %}
        <h1>No hay cartas disponibles</h1>
        <div class="juego-mensaje">
            <p>No se han podido preparar tres cartas. Comprueba que el catálogo de Pokémon esté cargado.</p>
        </div>
    {% elseif ronda.pokemonElegido is null %}
        <h1>¡Prepárate para elegir!</h1>
        <p class="juego-subtitulo" id="instruccion-cartas">Pulsa empezar para barajar las tres cartas. Después podrás elegir la que quieras.</p>

        <div class="pack-actions">
            <button class="btn-pack" id="empezar-barajar" type="button">Empezar</button>
        </div>

        <div class="cartas-pack" id="zona-cartas" hidden>
            {% for carta in ronda.cartas|sort((a, b) => a.posicion <=> b.posicion) %}
                <article class="carta-pack">
                    <form class="carta-form" method="post" action="{{ path('app_juego_elegir', {posicion: carta.posicion}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('elegir' ~ carta.posicion) }}">
                        <button type="submit" disabled aria-label="Elegir carta {{ carta.posicion }}">
                            <div class="carta-interior">
                                <span class="carta-numero">CARD {{ '%02d'|format(carta.posicion) }}</span>
                                <div class="reverso-pokeball"></div>
                                <span class="reverso-titulo">POKÉMON</span>
                            </div>
                        </button>
                    </form>
                </article>
            {% endfor %}
        </div>
        <p class="juego-ayuda" id="ayuda-cartas">Las cartas aparecerán aquí cuando pulses Empezar.</p>

        <script>
            (() => {
                const startButton = document.getElementById('empezar-barajar');
                const cardZone = document.getElementById('zona-cartas');
                const instruction = document.getElementById('instruccion-cartas');
                const help = document.getElementById('ayuda-cartas');

                if (!startButton || !cardZone) return;

                startButton.addEventListener('click', () => {
                    if (startButton.disabled) return;

                    startButton.disabled = true;
                    startButton.textContent = 'Barajando...';
                    cardZone.hidden = false;

                    // Reordena las cartas de forma aleatoria sin cambiar su posición
                    // asociada en el formulario ni la validación del servidor.
                    const cards = Array.from(cardZone.children);
                    for (let i = cards.length - 1; i > 0; i--) {
                        const j = Math.floor(Math.random() * (i + 1));
                        [cards[i], cards[j]] = [cards[j], cards[i]];
                    }
                    cards.forEach((card, index) => {
                        cardZone.appendChild(card);
                        // Las cartas cruzan visualmente sus posiciones, como un barajado real.
                        const directions = [-115, 0, 115];
                        const rotations = [-13, 9, -11];
                        card.style.setProperty('--shuffle-x', directions[index] + 'px');
                        card.style.setProperty('--shuffle-rotate', rotations[index] + 'deg');
                        card.style.setProperty('--shuffle-delay', (index * 110) + 'ms');
                        const button = card.querySelector('button[type="submit"]');
                        if (button) button.disabled = true;
                    });

                    cardZone.classList.remove('barajando');
                    void cardZone.offsetWidth;
                    cardZone.classList.add('barajando');

                    instruction.textContent = '¡Cartas barajadas! Elige una para descubrir tu Pokémon.';
                    help.textContent = 'Selecciona una de las tres cartas. Tu elección será la que utilices en el combate.';

                    window.setTimeout(() => {
                        cardZone.classList.remove('barajando');
                        cards.forEach(card => {
                            card.style.removeProperty('--shuffle-x');
                            card.style.removeProperty('--shuffle-rotate');
                            card.style.removeProperty('--shuffle-delay');
                            const button = card.querySelector('button[type="submit"]');
                            if (button) button.disabled = false;
                        });
                        startButton.textContent = '¡Cartas listas!';
                    }, 1150);
                });
            })();
        </script>
    {% else %}
        {% set elegido = ronda.pokemonElegido %}
        <h1>¡Carta revelada!</h1>
        <p class="juego-subtitulo">Este es tu Pokémon para el próximo combate.</p>

        <div class="carta-elegida">
            <article class="carta-pack">
                <div class="carta-interior" style="background:linear-gradient(160deg,#e9f1fb,#b8cde9);color:#15233a">
                    <span class="carta-numero" style="color:#263b5a">TU CARTA</span>
                    <h2 class="pokemon-nombre">{{ elegido.nombre }}</h2>
                    <img class="pokemon-imagen" src="{{ elegido.imagenUrl }}" alt="{{ elegido.nombre }}">
                    <div class="pokemon-tipos">
                        {% for tipo in elegido.tipos %}
                            <span class="tipo">{{ tipo.nombre }}</span>
                        {% endfor %}
                    </div>
                    <div class="pokemon-datos">
                        <p><span>HP</span><strong>{{ elegido.hp }}</strong></p>
                        <p><span>Ataque</span><strong>{{ elegido.ataque }}</strong></p>
                    </div>
                </div>
            </article>
        </div>

        <div class="pack-actions">
            <form method="post" action="{{ path('app_juego_combatir') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('combatir') }}">
                <button class="btn-pack btn-combatir" type="submit">¡Ir al combate!</button>
            </form>
        </div>
        <p class="juego-ayuda">Tu Pokémon ya está preparado. ¡Veamos quién gana!</p>
    {% endif %}
</section>
{% endblock %}
