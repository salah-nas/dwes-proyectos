{% extends 'base.html.twig' %}

{% block title %}Elegir carta · Cartas Pokémon{% endblock %}

{% block body %}
<section class="pantalla-juego">
    <p class="juego-eyebrow">Pokémon Trading Cards</p>
    {% if ronda is null %}
        <h1>No hay cartas disponibles</h1>
        <div class="juego-mensaje">
            <p>No se han podido preparar tres cartas. Comprueba que el catálogo de Pokémon esté cargado.</p>
        </div>
    {% elseif ronda.pokemonElegido is null %}
        <h1>¡Prepárate para elegir!</h1>
        <p class="juego-subtitulo">Tus tres cartas misteriosas están boca abajo: elige una para descubrir tu Pokémon.</p>

        <div class="cartas-pack" id="zona-cartas">
            {% for carta in ronda.cartas|sort((a, b) => a.posicion <=> b.posicion) %}
                <article class="carta-pack">
                    <form class="carta-form" method="post" action="{{ path('app_juego_elegir', {posicion: carta.posicion}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('elegir' ~ carta.posicion) }}">
                        <button type="submit" aria-label="Elegir carta {{ loop.index }}">
                            <div class="carta-flota">
                                <div class="carta-giro">
                                    <div class="cara reverso" aria-hidden="true">
                                        <div class="carta-reverso">
                                            <img src="{{ app.request.basePath }}/images/reverso-carta.svg" alt="" loading="eager">
                                        </div>
                                    </div>
                                    <div class="cara frente">
                                        {% include 'gestion/_carta_frente.html.twig' with {elegido: carta.pokemon} %}
                                    </div>
                                </div>
                            </div>
                        </button>
                    </form>
                </article>
            {% endfor %}
        </div>
        <p class="juego-ayuda" id="ayuda-cartas">Pasa el ratón por encima para destacar una carta y púlsala para darle la vuelta.</p>

        <script>
            (() => {
                const zona = document.getElementById('zona-cartas');
                const ayuda = document.getElementById('ayuda-cartas');
                const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                let girando = false;

                zona.querySelectorAll('.carta-pack').forEach(carta => {
                    const flota = carta.querySelector('.carta-flota');
                    const form = carta.querySelector('form');

                    // Inclinación 3D y brillo que siguen al ratón.
                    carta.addEventListener('mousemove', e => {
                        if (girando) return;
                        const r = carta.getBoundingClientRect();
                        const x = (e.clientX - r.left) / r.width;
                        const y = (e.clientY - r.top) / r.height;
                        flota.style.setProperty('--ry', ((x - .5) * 16) + 'deg');
                        flota.style.setProperty('--rx', ((.5 - y) * 16) + 'deg');
                        flota.style.setProperty('--mx', (x * 100) + '%');
                        flota.style.setProperty('--my', (y * 100) + '%');
                    });
                    carta.addEventListener('mouseleave', () => {
                        if (girando) return;
                        flota.style.setProperty('--rx', '0deg');
                        flota.style.setProperty('--ry', '0deg');
                    });

                    // Al pulsar: la carta se da la vuelta y, al terminar, se guarda la elección.
                    form.addEventListener('submit', e => {
                        e.preventDefault();
                        if (girando) return;
                        girando = true;
                        flota.style.setProperty('--rx', '0deg');
                        flota.style.setProperty('--ry', '0deg');
                        zona.classList.add('eligiendo');
                        carta.classList.add('girada');
                        if (ayuda) ayuda.textContent = '¡Descubriendo tu Pokémon…!';
                        window.setTimeout(() => form.submit(), reducido ? 150 : 1500);
                    });
                });
            })();
        </script>
    {% else %}
        {% set elegido = ronda.pokemonElegido %}
        <h1>¡Carta revelada!</h1>
        <p class="juego-subtitulo">Este es tu Pokémon para el próximo combate.</p>

        <div class="carta-elegida">
            <article class="carta-pack" id="carta-revelada">
                <div class="carta-flota">
                    <div class="cara frente">
                        {% include 'gestion/_carta_frente.html.twig' with {elegido: elegido} %}
                    </div>
                </div>
            </article>
        </div>

        <div class="pack-actions">
            <form method="post" action="{{ path('app_juego_combatir') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('combatir') }}">
                <button class="btn-pack btn-combatir" type="submit">¡Ir al combate!</button>
            </form>
        </div>
        <p class="juego-ayuda">Tu Pokémon ya está preparado. ¡Veamos quién gana!</p>

        <script>
            (() => {
                const carta = document.getElementById('carta-revelada');
                const flota = carta && carta.querySelector('.carta-flota');
                if (!flota) return;
                carta.addEventListener('mousemove', e => {
                    const r = carta.getBoundingClientRect();
                    const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
                    flota.style.setProperty('--ry', ((x - .5) * 14) + 'deg');
                    flota.style.setProperty('--rx', ((.5 - y) * 14) + 'deg');
                    flota.style.setProperty('--mx', (x * 100) + '%');
                    flota.style.setProperty('--my', (y * 100) + '%');
                });
                carta.addEventListener('mouseleave', () => {
                    flota.style.setProperty('--rx', '0deg');
                    flota.style.setProperty('--ry', '0deg');
                });
            })();
        </script>
    {% endif %}
</section>
{% endblock %}
