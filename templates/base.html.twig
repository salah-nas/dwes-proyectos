<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Cartas Pokémon{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ app.request.basePath }}/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        :root { --rojo:#d7382d; --azul:#2a5db0; --fondo:#f4f5f7; --texto:#1f2430; --gris:#6b7280; --borde:#d9dce3; }
        * { box-sizing: border-box; }
        body { margin:0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background:var(--fondo); color:var(--texto); line-height:1.5; }
        nav { background:var(--rojo); color:#fff; padding:.7rem 1.2rem; display:flex; gap:1.2rem; align-items:center; flex-wrap:wrap; }
        nav a { color:#fff; text-decoration:none; font-weight:500; }
        nav a:hover { text-decoration:underline; }
        nav .marca { font-weight:700; font-size:1.15rem; margin-right:auto; }
        main { max-width:960px; margin:0 auto; padding:1.5rem 1.2rem 3rem; }
        h1 { margin:.2rem 0 .6rem; }
        .panel { background:#fff; border:1px solid var(--borde); border-radius:12px; padding:1.4rem; max-width:460px; margin:1rem auto; }
        .panel.ancho { max-width:none; }
        .alert { padding:.7rem 1rem; border-radius:8px; margin:.8rem 0; }
        .alert.error { background:#fdeceb; color:#8a1f17; border:1px solid #f3c2be; }
        .alert.success { background:#e6f6ee; color:#116a3c; border:1px solid #b8e3cb; }
        label { display:block; font-weight:500; margin:.8rem 0 .25rem; }
        input[type=text], input[type=email], input[type=password] { width:100%; padding:.6rem .7rem; border:1px solid var(--borde); border-radius:8px; font-size:1rem; }
        .btn, button.btn { display:inline-block; background:var(--azul); color:#fff; border:0; border-radius:8px; padding:.65rem 1.2rem; font-size:1rem; cursor:pointer; text-decoration:none; margin-top:1rem; }
        .btn:hover { filter:brightness(1.1); }
        .btn.big { font-size:1.15rem; padding:.85rem 1.6rem; background:var(--rojo); }
        .btn.sec { background:#fff; color:var(--azul); border:1px solid var(--azul); }
        ul.errores, form ul { color:#8a1f17; padding-left:1.1rem; margin:.3rem 0; font-size:.9rem; }
        .cards { display:flex; gap:1.2rem; flex-wrap:wrap; justify-content:center; margin:1.5rem 0; }
        .card { width:210px; min-height:300px; border-radius:14px; padding:1rem; text-align:center; }
        .card.front { background:#fff; border:2px solid var(--borde); box-shadow:0 2px 8px rgba(0,0,0,.08); }
        .card.front img { width:140px; height:140px; object-fit:contain; }
        .card.front h3 { margin:.2rem 0 .4rem; }
        .card.back { background:linear-gradient(160deg,#2a5db0,#183b7a); color:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center; border:4px solid #f5c518; }
        .card.back span { font-size:5rem; font-weight:700; }
        .card.back.dim { opacity:.35; }
        .card-btn { border:0; background:none; padding:0; cursor:pointer; transition:transform .15s; }
        .card-btn:hover, .card-btn:focus-visible { transform:translateY(-6px) rotate(-1deg); }
        .tipo { display:inline-block; background:var(--azul); color:#fff; border-radius:999px; padding:.05rem .6rem; font-size:.78rem; margin:0 .15rem; }
        ul.stats { list-style:none; padding:0; margin:.6rem 0 0; text-align:left; font-size:.9rem; }
        ul.stats li { display:flex; justify-content:space-between; border-bottom:1px dashed var(--borde); padding:.15rem 0; }
        .vs { display:flex; align-items:center; font-size:1.8rem; font-weight:700; color:var(--rojo); }
        .banner { text-align:center; font-size:1.6rem; font-weight:700; padding:.8rem; border-radius:12px; }
        .banner.victoria { background:#e6f6ee; color:#116a3c; }
        .banner.derrota { background:#fdeceb; color:#8a1f17; }
        .banner.empate { background:#fff6db; color:#7a5a00; }
        table { width:100%; border-collapse:collapse; background:#fff; border-radius:10px; overflow:hidden; }
        th, td { padding:.6rem .8rem; text-align:left; border-bottom:1px solid var(--borde); }
        th { background:#eef0f4; }
        .pokedex .card { width:180px; min-height:250px; padding:.8rem; }
        .pokedex .card.front img { width:110px; height:110px; }
        .pokedex .card .num { font-size:.8rem; color:var(--gris); }
        .card.pendiente { background:#eceef2; border:2px dashed var(--borde); box-shadow:none; }
        .card.pendiente img { filter:brightness(0); opacity:.3; }
        .progreso { background:#dfe2e8; border-radius:999px; height:14px; overflow:hidden; margin:.4rem 0 1rem; }
        .progreso > div { background:var(--rojo); height:100%; }
        .filtros { display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:.5rem; }
        .filtros a { padding:.35rem .9rem; border-radius:999px; border:1px solid var(--azul); color:var(--azul); text-decoration:none; font-size:.9rem; }
        .filtros a.activo { background:var(--azul); color:#fff; }
        .centro { text-align:center; }
        .gris { color:var(--gris); }

        /* --- Experiencia de apertura de cartas --- */
        body{background:#202020;color:#f5f5f5;font-family:Arial,Helvetica,sans-serif}
        nav{background:#202020;border-bottom:1px solid #333;padding:.7rem clamp(1rem,4vw,3rem)}
        nav .marca{color:#fff;display:inline-flex;align-items:center;gap:.45rem;font-weight:800;letter-spacing:-.025em}
        nav .marca:hover{color:#fff}
        .logo-cartas{width:34px;height:34px;flex:0 0 34px;filter:drop-shadow(0 3px 5px rgba(0,0,0,.35));transition:transform .2s ease}
        .logo-wordmark{width:clamp(178px,19vw,240px);height:auto;flex:0 0 auto;overflow:visible}
        nav .marca:hover .logo-wordmark{transform:translateY(-1px) scale(1.025)}
        nav a{color:#e8e8e8}
        nav a:hover{color:#ffd52a}
        main{max-width:1180px;padding:2.3rem 1.2rem 4rem}
        h1,h2,h3{color:#fff}
        .pantalla-juego{min-height:calc(100vh - 150px);text-align:center;padding:1rem 0 3rem}
        .juego-eyebrow{color:#aaa;font-size:.78rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;margin:0 0 .6rem}
        .pantalla-juego h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.8rem,4vw,2.65rem);font-weight:900;letter-spacing:-.045em;margin:.25rem 0 .6rem;color:#ffdf45;text-shadow:2px 3px 0 #174b9b,-1px -1px 0 #174b9b,1px -1px 0 #174b9b,-1px 1px 0 #174b9b,1px 1px 0 #174b9b,0 7px 18px rgba(0,0,0,.55)}
        .juego-subtitulo{color:#b8b8b8;margin:0 auto;max-width:600px}
        .pack-actions{margin:1.5rem auto 2rem}
        .btn-pack{
            display:inline-flex;align-items:center;justify-content:center;min-width:190px;
            padding:.78rem 1.65rem;border:0;border-radius:7px;color:#fff;text-decoration:none;
            font-size:.92rem;font-weight:700;letter-spacing:.01em;cursor:pointer;
            background:linear-gradient(105deg,#ffc928 0%,#fa3984 48%,#00d5a5 100%);
            box-shadow:0 5px 18px rgba(0,0,0,.22);transition:transform .2s,filter .2s,box-shadow .2s
        }
        .btn-pack:hover{transform:translateY(-3px);filter:saturate(1.15);box-shadow:0 9px 24px rgba(0,0,0,.35);color:#fff}
        .btn-combatir{margin-top:1.4rem}
        .juego-ayuda{color:#999;font-size:.9rem;margin:1.4rem auto}
        .juego-mensaje{max-width:560px;margin:2rem auto;padding:1.1rem 1.4rem;border:1px solid #414141;border-radius:12px;background:#292929;color:#ddd}
        .flash-error{color:#ffb4ae}

        /* ================= CARTAS (proporción real 63 x 88 mm) ================= */
        .cartas-pack{
            display:flex;justify-content:center;align-items:center;flex-wrap:wrap;
            gap:clamp(1rem,3vw,2.2rem);margin:2.8rem auto 1.5rem;padding:1.5rem 0;
            perspective:1400px
        }
        .carta-pack{
            --w:clamp(190px,22vw,262px);
            position:relative;width:var(--w);aspect-ratio:63/88;
            container-type:inline-size;
            transition:opacity .35s ease,filter .35s ease,scale .35s ease;
            animation:cartaEntrada .6s cubic-bezier(.2,.8,.2,1) backwards
        }
        .carta-pack:nth-child(2){animation-delay:.12s}
        .carta-pack:nth-child(3){animation-delay:.24s}

        /* La carta se compone de: flota (inclinación) > giro (vuelta 3D) > caras (marco dorado) */
        .carta-form{height:100%;margin:0}
        .carta-form button{
            display:block;position:relative;width:100%;height:100%;padding:0;border:0;background:none;
            cursor:pointer;color:inherit;text-align:left;perspective:1400px;-webkit-tap-highlight-color:transparent
        }
        .carta-form button:focus-visible{outline:4px solid #fff;outline-offset:6px;border-radius:5cqw}
        .carta-flota{
            position:absolute;inset:0;transform-style:preserve-3d;
            transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));
            transition:transform .25s ease-out;will-change:transform
        }
        .carta-giro{
            position:absolute;inset:0;transform-style:preserve-3d;
            transition:transform 1.1s cubic-bezier(.5,.05,.2,1)
        }
        .carta-pack.girada .carta-giro{transform:rotateY(180deg)}

        /* Marco dorado con esquinas redondeadas como las cartas oficiales */
        .cara{
            position:absolute;inset:0;border-radius:5cqw;padding:3.4cqw;
            background:linear-gradient(135deg,#fff08b 0%,#e0b200 26%,#fff17a 52%,#c79400 78%,#f6d948 100%);
            box-shadow:0 12px 26px rgba(0,0,0,.5),inset 0 0 0 1px rgba(255,255,255,.7);
            -webkit-backface-visibility:hidden;backface-visibility:hidden;
            transition:box-shadow .3s ease
        }
        .cara.frente{transform:rotateY(180deg)}
        .carta-elegida .cara.frente{transform:none}

        .carta-reverso{
            position:relative;width:100%;height:100%;overflow:hidden;
            border-radius:3cqw;background:#0b2f7a;box-shadow:inset 0 0 0 1.5px rgba(0,0,0,.35)
        }
        .carta-reverso img{display:block;width:100%;height:100%;object-fit:cover}

        /* Brillo que sigue al ratón */
        .cara:after{
            content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
            background:
                radial-gradient(circle at var(--mx,50%) var(--my,50%),rgba(255,255,255,.55),rgba(255,255,255,0) 52%),
                linear-gradient(115deg,rgba(255,0,128,0) 30%,rgba(255,255,255,.22) 45%,rgba(0,220,255,.18) 55%,rgba(255,0,128,0) 70%);
            mix-blend-mode:soft-light;opacity:0;transition:opacity .3s ease
        }

        /* --- Hover: la carta se eleva, flota y las demás se apagan --- */
        .carta-pack:hover{z-index:5;animation:cartaFlota 2.4s ease-in-out infinite}
        .carta-pack:hover .carta-flota{transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) scale(1.09)}
        .carta-pack:hover .cara{box-shadow:0 34px 55px rgba(0,0,0,.65),0 0 34px rgba(255,214,60,.38),inset 0 0 0 1px rgba(255,255,255,.8)}
        .carta-pack:hover .cara:after{opacity:1}
        .cartas-pack:has(.carta-pack:hover) .carta-pack:not(:hover){
            opacity:.5;filter:brightness(.62) saturate(.75) blur(1.2px);scale:.93
        }
        .carta-pack:focus-within .cara{box-shadow:0 0 0 3px #fff,0 18px 36px rgba(0,0,0,.55)}

        /* --- Al elegir: la carta se da la vuelta y las otras se apartan --- */
        .carta-pack.girada{z-index:8;animation:cartaSube 1.1s ease-in-out forwards}
        .carta-pack.girada .carta-flota{transform:scale(1.16)}
        .carta-pack.girada .cara{box-shadow:0 40px 60px rgba(0,0,0,.7),0 0 46px rgba(255,214,60,.55)}
        .cartas-pack.eligiendo .carta-pack:not(.girada){opacity:.25;filter:brightness(.5) blur(2px);scale:.88;pointer-events:none}
        .cartas-pack.eligiendo .carta-pack{cursor:default}

        @keyframes cartaFlota{
            0%,100%{translate:0 -12px}
            50%{translate:0 -22px}
        }
        @keyframes cartaSube{
            0%{translate:0 -12px}
            45%{translate:0 -34px}
            100%{translate:0 -16px}
        }
        @keyframes cartaEntrada{
            from{opacity:0;transform:translateY(28px) scale(.94)}
            to{opacity:1;transform:translateY(0) scale(1)}
        }

        /* ================= CARTA REVELADA (a pantalla completa, estilo carta V) ================= */
        .carta-elegida{display:flex;justify-content:center;margin:2.2rem auto;perspective:1400px}
        .carta-elegida .carta-pack{--w:clamp(240px,32vw,320px)}
        .carta-frente{
            --c1:#4a3a8c;--c2:#b79bff;
            position:relative;height:100%;border-radius:3cqw;overflow:hidden;text-align:left;color:#fff;
            display:flex;flex-direction:column;
            background:radial-gradient(circle at 50% 36%,var(--c2) 0%,var(--c1) 62%,#0c0b18 100%);
            box-shadow:inset 0 0 0 1.4cqw rgba(8,8,18,.55)
        }
        .carta-frente:before{ /* trama holográfica */
            content:"";position:absolute;inset:0;pointer-events:none;z-index:1;opacity:.55;mix-blend-mode:overlay;
            background:
                repeating-linear-gradient(115deg,rgba(255,255,255,0) 0 3cqw,rgba(255,255,255,.16) 3.4cqw 4cqw),
                radial-gradient(circle at 25% 20%,rgba(255,255,255,.5),transparent 40%)
        }
        .carta-arte{position:absolute;left:0;right:0;top:10%;height:62%;z-index:0;display:flex;align-items:center;justify-content:center}
        .carta-arte:before{content:"";position:absolute;width:78%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.75),rgba(255,255,255,0) 68%);filter:blur(2cqw)}
        .carta-arte img{position:relative;width:92%;height:100%;object-fit:contain;filter:drop-shadow(0 3cqw 3cqw rgba(0,0,0,.45))}
        .carta-arte .sin-imagen{display:none;position:relative;font-size:34cqw}
        .carta-arte.fallo img{display:none}
        .carta-arte.fallo .sin-imagen{display:block}

        .carta-cabecera{position:relative;z-index:3;display:flex;align-items:center;gap:2cqw;padding:4.2cqw 4cqw 0}
        .carta-etapa{
            font-size:2.1cqw;font-weight:900;font-style:italic;letter-spacing:.03em;text-transform:uppercase;
            padding:.7cqw 2.6cqw .7cqw 2cqw;background:rgba(10,10,20,.78);border:1px solid rgba(255,255,255,.4);
            clip-path:polygon(0 0,100% 0,88% 100%,0 100%)
        }
        .carta-nombre{
            margin:0 auto 0 0!important;font-family:Georgia,'Times New Roman',serif;font-size:6cqw;font-weight:900;font-style:italic;
            line-height:1.05;color:#fff!important;text-shadow:0 0 1.4cqw #000,0 .4cqw .8cqw #000,.3cqw .3cqw 0 #000;
            white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0
        }
        .carta-hp{font-size:3cqw;font-weight:900;text-shadow:0 0 1cqw #000;white-space:nowrap}
        .carta-hp b{font-size:7cqw;font-weight:900;margin-left:.6cqw;text-shadow:0 0 1.4cqw #000,.3cqw .3cqw 0 #000}
        .tipo-icono{
            flex:0 0 auto;width:7.2cqw;height:7.2cqw;border-radius:50%;display:grid;place-items:center;font-size:4cqw;
            background:radial-gradient(circle at 35% 30%,#fff,var(--c2) 55%,var(--c1));border:.5cqw solid #fff;box-shadow:0 .5cqw 1.2cqw rgba(0,0,0,.5);color:#14141f
        }

        .carta-espacio{flex:1;min-height:0}
        .carta-ataques{position:relative;z-index:3;padding:10cqw 4cqw 2cqw;background:linear-gradient(to bottom,rgba(8,8,20,0),rgba(8,8,20,.78) 38%,rgba(8,8,20,.9))}
        .carta-ataque{display:flex;align-items:center;gap:2cqw;padding:1.3cqw 0}
        .carta-ataque + .carta-ataque{border-top:1px solid rgba(255,255,255,.18)}
        .energias{display:flex;gap:.8cqw;min-width:15cqw}
        .energia{width:5.2cqw;height:5.2cqw;border-radius:50%;display:grid;place-items:center;font-size:3cqw;background:radial-gradient(circle at 35% 30%,#fff,var(--c2) 60%,var(--c1));border:.4cqw solid #fff;color:#14141f}
        .energia.neutra{background:radial-gradient(circle at 35% 30%,#fff,#cfd2dc 60%,#8a8fa0)}
        .carta-ataque span.nombre{flex:1;font-size:6cqw;font-weight:800;text-shadow:0 .3cqw .8cqw #000}
        .carta-ataque b{font-size:7cqw;font-weight:900;text-shadow:0 .3cqw .8cqw #000}

        .carta-barra{position:relative;z-index:3;display:grid;grid-template-columns:repeat(3,1fr);gap:1.4cqw;padding:0 4cqw 1.6cqw;background:rgba(8,8,20,.9)}
        .carta-barra div{font-size:2.5cqw;font-weight:800;text-transform:uppercase;letter-spacing:.02em;padding:1.1cqw 1.6cqw;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.28);border-radius:1.2cqw;display:flex;justify-content:space-between;align-items:center;gap:1cqw}
        .carta-barra div b{font-size:3.3cqw}
        .carta-pie{position:relative;z-index:3;display:flex;justify-content:space-between;gap:2cqw;padding:0 4.4cqw 3cqw;font-size:2.3cqw;font-style:italic;color:#d8d8e6;background:rgba(8,8,20,.9)}


        /* ---- Menú de navegación ---- */
        nav .marca{margin-right:auto}
        .nav-links{display:flex;align-items:center;gap:.35rem;flex-wrap:wrap}
        .nav-link,.nav-usuario{
            font-family:'Fredoka','Trebuchet MS','Segoe UI',Arial,sans-serif;font-size:1.02rem;font-weight:600;
            letter-spacing:.07em;text-transform:uppercase
        }
        nav a.nav-link{
            position:relative;padding:.5rem 1rem;border-radius:999px;color:#e9ecf5;text-decoration:none;
            transition:color .2s,background .2s,transform .2s,box-shadow .2s
        }
        nav a.nav-link:after{
            content:"";position:absolute;left:1rem;right:1rem;bottom:.22rem;height:3px;border-radius:3px;
            background:linear-gradient(90deg,#ffd52a,#ff4f8b);transform:scaleX(0);transform-origin:left;transition:transform .25s ease
        }
        nav a.nav-link:hover{color:#fff;text-decoration:none;background:rgba(255,255,255,.07);transform:translateY(-2px)}
        nav a.nav-link:hover:after,nav a.nav-link.activo:after{transform:scaleX(1)}
        nav a.nav-link.activo{color:#ffd52a;text-shadow:0 0 14px rgba(255,213,42,.45)}
        .nav-usuario{
            margin:0 .4rem 0 .9rem;padding:.38rem .95rem .38rem .45rem;border-radius:999px;color:#fff;
            background:linear-gradient(135deg,rgba(255,255,255,.12),rgba(255,255,255,.04));border:1px solid rgba(255,255,255,.18);
            display:inline-flex;align-items:center;gap:.5rem;text-transform:none;letter-spacing:.03em
        }
        .nav-usuario:before{
            content:"";width:1.35rem;height:1.35rem;border-radius:50%;flex:0 0 auto;
            background:linear-gradient(to bottom,#e8261d 0 44%,#14141c 44% 56%,#fff 56% 100%);border:2px solid #14141c;box-shadow:0 0 0 1.5px #fff
        }
        nav a.nav-salir{border:1.5px solid rgba(255,213,42,.7);color:#ffd52a}
        nav a.nav-salir:after{display:none}
        nav a.nav-salir:hover{background:#ffd52a;color:#1a1a22;box-shadow:0 6px 16px rgba(255,213,42,.28)}

        /* ---- Texto legible sobre superficies claras (Pokédex, combate, historial) ---- */
        .card,.panel,table,th,td{color:var(--texto)}
        .card h1,.card h2,.card h3,.panel h1,.panel h2,.panel h3{color:var(--texto)}
        .card.pendiente h3{color:#6b7280}
        .card .gris,.panel .gris,table .gris{color:var(--gris)}
        main > .gris,main > p.gris,.centro.gris{color:#aeb4c2}
        .pokedex .card .num{color:var(--gris)}
        .card-btn,.card-btn *{color:inherit}
        table th{color:#2b3140}
        table td strong{color:var(--texto)}
        table a{color:var(--azul)}
        .alert{color:#1f2430}
        .alert.error{color:#8a1f17}.alert.success{color:#116a3c}
        .alert a{color:var(--azul)}
        @media(max-width:650px){
            main{padding-top:1.2rem}
            .carta-pack{--w:min(42vw,200px)}
        }
        @media(prefers-reduced-motion:reduce){
            .carta-pack,.carta-pack:hover,.carta-flota,.carta-giro{animation:none!important;transition:none!important}
        }
    </style>
</head>
<body>
<nav>
    <a class="marca" href="{{ path('app_main') }}" aria-label="Cartas Pokémon, inicio">
        <svg class="logo-cartas logo-wordmark" viewBox="0 0 270 76" role="img" aria-label="Cartas Pokémon">
            <defs>
                <linearGradient id="pokeYellow" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#fff36a"/><stop offset=".55" stop-color="#ffca20"/><stop offset="1" stop-color="#f3a900"/>
                </linearGradient>
            </defs>
            <text x="136" y="18" text-anchor="middle" font-size="10" font-weight="900" letter-spacing="3" fill="#fff">JUEGO DE CARTAS</text>
            <text x="136" y="59" text-anchor="middle" font-family="Arial Black,Arial,sans-serif" font-size="43" font-weight="1000" font-style="italic" fill="url(#pokeYellow)" stroke="#174b9b" stroke-width="8" stroke-linejoin="round" paint-order="stroke">Pokémon</text>
            <text x="136" y="59" text-anchor="middle" font-family="Arial Black,Arial,sans-serif" font-size="43" font-weight="1000" font-style="italic" fill="url(#pokeYellow)" stroke="#fff" stroke-width="1.3" stroke-linejoin="round" paint-order="stroke">Pokémon</text>
        </svg>
    </a>
    {% set ruta = app.request.attributes.get('_route') %}
    <div class="nav-links">
    {% if app.user %}
        <a class="nav-link{{ ruta == 'app_juego' or ruta == 'app_combate' ? ' activo' : '' }}" href="{{ path('app_juego') }}">Jugar</a>
        <a class="nav-link{{ ruta == 'app_pokedex' ? ' activo' : '' }}" href="{{ path('app_pokedex') }}">Pokédex</a>
        <a class="nav-link{{ ruta == 'app_historial' ? ' activo' : '' }}" href="{{ path('app_historial') }}">Historial</a>
        <span class="nav-usuario">{{ app.user.nombreUsuario }}</span>
        <a class="nav-link nav-salir" href="{{ path('app_logout') }}">Salir</a>
    {% else %}
        <a class="nav-link{{ ruta == 'app_login' ? ' activo' : '' }}" href="{{ path('app_login') }}">Entrar</a>
        <a class="nav-link nav-salir" href="{{ path('app_registro') }}">Registrarse</a>
    {% endif %}
    </div>
</nav>
<main>
    {% for tipo, mensajes in app.flashes %}
        {% for mensaje in mensajes %}
            <div class="alert {{ tipo }}">{{ mensaje }}</div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
