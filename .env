# Valores por defecto para que el proyecto funcione tras clonarlo.
# Para tus datos reales/secretos crea un archivo .env.local (está en .gitignore).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=clave-de-desarrollo-cambiala-en-env-local
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite por defecto: no necesita servidor de base de datos.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# Para MySQL/MariaDB, define en .env.local (no aquí):
# DATABASE_URL="mysql://USUARIO:CLAVE@127.0.0.1:3306/pokemon_cartas?serverVersion=mariadb-10.11.6&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
